# Production Environment Variables
# WARNING: Never commit this file - use a secure vault instead

# Application
NODE_ENV=production
APP_NAME=Scraping API
APP_PORT=5000
APP_HOST=0.0.0.0
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Database
DATABASE_URL=postgresql://prod_user:prod_password@prod-db-host:5432/scraping_db_prod
DATABASE_LOG=error

# Redis
REDIS_HOST=prod-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-password
REDIS_DB=0

# Meilisearch
MEILISEARCH_HOST=https://search.yourdomain.com
MEILISEARCH_API_KEY=your-meilisearch-key

# JWT
JWT_SECRET=your-secure-jwt-secret-key
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your-secure-refresh-secret-key
REFRESH_TOKEN_EXPIRATION=30d

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Scraping
SCRAPER_TIMEOUT=60000
SCRAPER_RETRY_COUNT=5
SCRAPER_RETRY_DELAY=2000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Bull Queue
BULL_QUEUE_REDIS_HOST=prod-redis-host
BULL_QUEUE_REDIS_PORT=6379

# External Services
WEBHOOK_URL=https://yourdomain.com/webhooks

# Email
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=your-sendgrid-key
MAIL_FROM=noreply@yourdomain.com

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=your-bucket-name

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Sentry
SENTRY_DSN=your-sentry-dsn
