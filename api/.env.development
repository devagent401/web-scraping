# Development Environment Variables

# Application
NODE_ENV=development
APP_NAME=Scraping API
APP_PORT=4001
APP_HOST=0.0.0.0
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://scraping_user:scraping_password@postgres:5432/scraping_db
DATABASE_LOG=query,error

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=masterKey

# JWT
JWT_SECRET=dev-secret-key-change-this-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=dev-refresh-secret-key-change-this-in-production
REFRESH_TOKEN_EXPIRATION=30d

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Scraping
SCRAPER_TIMEOUT=30000
SCRAPER_RETRY_COUNT=3
SCRAPER_RETRY_DELAY=1000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Bull Queue
BULL_QUEUE_REDIS_HOST=redis
BULL_QUEUE_REDIS_PORT=6379

# Debugging
DEBUG=*
