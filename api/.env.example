# Application
NODE_ENV=development
APP_NAME=Scraping API
PORT=4001
APP_HOST=localhost
API_VERSION=1.0.0
API_BASE_URL=http://localhost:4001
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_TO_FILE=true

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=60000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/scraping_db
DATABASE_LOG=query,error

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your-refresh-secret-key-change-this-in-production
REFRESH_TOKEN_EXPIRATION=30d

# Scraping
SCRAPER_TIMEOUT=30000
SCRAPER_RETRY_COUNT=3
SCRAPER_RETRY_DELAY=1000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Bull Queue
BULL_QUEUE_REDIS_HOST=localhost
BULL_QUEUE_REDIS_PORT=6379

# Email (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# AWS (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# External APIs
WEBHOOK_URL=http://localhost:4001/webhooks
API_RATE_LIMIT=100
